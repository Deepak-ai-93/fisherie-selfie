# ── Directory listing ────────────────────────────────────
# Prevents anyone from browsing /uploads/ or any folder directly
Options -Indexes

# ── CORS for frame assets (SVG/PNG/images) ───────────────
# Allows the canvas in index.html to load and export the frame
# without triggering a browser security (tainted canvas) error
<IfModule mod_headers.c>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp)$">
    Header set Access-Control-Allow-Origin "https://isupportblueeconomy.click"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Vary "Origin"
  </FilesMatch>
</IfModule>

# ── Security headers ─────────────────────────────────────
<IfModule mod_headers.c>
  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Basic XSS protection
  Header always set X-XSS-Protection "1; mode=block"
  # Force HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Block direct access to PHP logs viewer from non-browser ─
# (gallery.php and logs-viewer.php handle their own auth)

# ── Block access to log files directly ───────────────────
<FilesMatch "\.(json|log|txt)$">
  Order deny,allow
  Deny from all
</FilesMatch>

# ── Block access to sensitive files ──────────────────────
<FilesMatch "^(consent-log|visits-log)">
  Order deny,allow
  Deny from all
</FilesMatch>

# ── Force HTTPS redirect ─────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
